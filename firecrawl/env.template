# --- firecrawl API ---
HOST=0.0.0.0
PORT=3002
ENV=local
LOGGING_LEVEL=info

# --- workers / queue ---
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
EXTRACT_WORKER_PORT=3004
WORKER_PORT=3005
HARNESS_STARTUP_TIMEOUT_MS=60000

# --- redis (../redis) ---
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379

# --- rabbitmq (../rabbitmq; credentials must match its .env) ---
NUQ_RABBITMQ_URL=amqp://user:password@rabbitmq:5672

# --- playwright (../playwright) ---
PLAYWRIGHT_MICROSERVICE_URL=http://playwright:3000/scrape

# --- nuq-postgres (../nuq-postgres; must match its .env) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432
USE_DB_AUTHENTICATION=false

# --- optional integrations: leave empty to disable ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
OLLAMA_BASE_URL=
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_TOKEN=
SUPABASE_SERVICE_TOKEN=
SELF_HOSTED_WEBHOOK_URL=
AUTUMN_SECRET_KEY=
SLACK_WEBHOOK_URL=
BULL_AUTH_KEY=
TEST_API_KEY=
